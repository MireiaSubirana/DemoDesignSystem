{
  "$about": {
    "whatIsThis": "This file is the single source of truth for every colour, font, space and corner-radius in the design system. It was read directly out of Figma, so the names here are EXACTLY the names a designer sees in the Figma Variables panel.",
    "howItIsUsed": "The script at scripts/build-tokens.mjs reads this file and writes src/styles/tokens.css, which turns every token into a CSS variable. Components only ever use those CSS variables - never a raw colour or number.",
    "ifFigmaChanges": "Re-read the variables from Figma, update this file, then run `npm run build:tokens` to regenerate the CSS.",
    "source": {
      "figmaFile": "01 - Step 1: Hand made Figma to Code (Community) (Copy)",
      "figmaFileKey": "VbGI9r1HSRAHoq47wXaYCn",
      "readOn": "2026-10-08",
      "totalVariables": 63,
      "totalCollections": 5
    },
    "keyToFields": {
      "modes": "A Figma 'mode' is a set of alternative values for the same token - like light vs dark, or small vs large screens.",
      "cssStrategy": "Tells the build script which CSS selector or media query each mode should become.",
      "unit": "The unit added when the value is written into CSS. Empty string means the number is used as-is (e.g. font-weight).",
      "values": "One value per mode. A value shaped { \"alias\": \"...\" } means 'use this other token's value' - exactly like an alias in Figma."
    }
  },

  "collections": {
    "color primitives": {
      "$description": "The raw palette. These are the only places a literal hex colour appears. Components should NOT use these directly - they should use the semantic 'color' collection below, so that light/dark mode works automatically.",
      "modes": ["default"],
      "cssStrategy": { "default": ":root" },
      "unit": "",
      "tokens": {
        "color/brand/100": { "type": "color", "description": "Lightest brand tint", "values": { "default": "#ffede5" } },
        "color/brand/200": { "type": "color", "description": "Very light brand", "values": { "default": "#ffccb8" } },
        "color/brand/300": { "type": "color", "description": "Light brand", "values": { "default": "#ffa585" } },
        "color/brand/400": { "type": "color", "description": "Medium-light brand", "values": { "default": "#ff8556" } },
        "color/brand/500": { "type": "color", "description": "Base brand orange", "values": { "default": "#ff6330" } },
        "color/brand/600": { "type": "color", "description": "Medium-dark brand", "values": { "default": "#e54d1a" } },
        "color/brand/700": { "type": "color", "description": "Dark brand", "values": { "default": "#b33b14" } },
        "color/brand/800": { "type": "color", "description": "Very dark brand", "values": { "default": "#80290d" } },
        "color/brand/900": { "type": "color", "description": "Darkest brand", "values": { "default": "#4d1707" } },
        "color/neutral/000": { "type": "color", "description": "Pure white", "values": { "default": "#ffffff" } },
        "color/neutral/100": { "type": "color", "description": "Lightest gray", "values": { "default": "#f7f7f7" } },
        "color/neutral/200": { "type": "color", "description": "Very light gray", "values": { "default": "#e8e8e8" } },
        "color/neutral/300": { "type": "color", "description": "Light gray", "values": { "default": "#d1d1d1" } },
        "color/neutral/400": { "type": "color", "description": "Medium-light gray", "values": { "default": "#a0a0a0" } },
        "color/neutral/500": { "type": "color", "description": "Mid gray", "values": { "default": "#737373" } },
        "color/neutral/600": { "type": "color", "description": "Medium-dark gray", "values": { "default": "#525252" } },
        "color/neutral/700": { "type": "color", "description": "Dark gray", "values": { "default": "#3d3d3d" } },
        "color/neutral/800": { "type": "color", "description": "Very dark gray", "values": { "default": "#2c2c2c" } },
        "color/neutral/900": { "type": "color", "description": "Near black", "values": { "default": "#161616" } },
        "color/neutral/999": { "type": "color", "description": "Pure black", "values": { "default": "#000000" } }
      }
    },

    "color": {
      "$description": "Semantic colours - named after their JOB ('text that is muted', 'the primary button when hovered') rather than their appearance. Each one points at a primitive, and points at a DIFFERENT primitive in dark mode. This is the layer components should use.",
      "modes": ["light", "dark"],
      "cssStrategy": { "light": ":root", "dark": "[data-theme=\"dark\"]" },
      "unit": "",
      "tokens": {
        "text/default": { "type": "color", "description": "Default body and heading text", "values": { "light": { "alias": "color/neutral/900" }, "dark": { "alias": "color/brand/100" } } },
        "text/muted": { "type": "color", "description": "Secondary text, captions", "values": { "light": { "alias": "color/neutral/600" }, "dark": { "alias": "color/neutral/400" } } },
        "text/inverse": { "type": "color", "description": "Text sitting on an inverse surface", "values": { "light": { "alias": "color/neutral/000" }, "dark": { "alias": "color/neutral/900" } } },
        "text/accent": { "type": "color", "description": "Brand-coloured text, used sparingly", "values": { "light": { "alias": "color/brand/500" }, "dark": { "alias": "color/brand/500" } } },
        "text/disabled": { "type": "color", "description": "Text of a disabled control", "values": { "light": { "alias": "color/neutral/400" }, "dark": { "alias": "color/neutral/600" } } },
        "surface/default": { "type": "color", "description": "Default page background", "values": { "light": { "alias": "color/neutral/000" }, "dark": { "alias": "color/neutral/900" } } },
        "surface/raised": { "type": "color", "description": "Cards and raised panels", "values": { "light": { "alias": "color/neutral/100" }, "dark": { "alias": "color/neutral/800" } } },
        "surface/inverse": { "type": "color", "description": "Inverse contrast sections", "values": { "light": { "alias": "color/neutral/900" }, "dark": { "alias": "color/neutral/100" } } },
        "surface/accent-subtle": { "type": "color", "description": "Subtle brand-tinted highlight", "values": { "light": { "alias": "color/brand/100" }, "dark": { "alias": "color/brand/900" } } },
        "border/default": { "type": "color", "description": "Standard border", "values": { "light": { "alias": "color/neutral/300" }, "dark": { "alias": "color/neutral/700" } } },
        "border/strong": { "type": "color", "description": "High emphasis border", "values": { "light": { "alias": "color/neutral/900" }, "dark": { "alias": "color/neutral/400" } } },
        "border/accent": { "type": "color", "description": "Brand accent border", "values": { "light": { "alias": "color/brand/500" }, "dark": { "alias": "color/brand/500" } } },
        "border/focus": { "type": "color", "description": "Focus ring on any interactive element (button, input, link)", "values": { "light": { "alias": "color/brand/500" }, "dark": { "alias": "color/brand/400" } } },
        "action/primary/default": { "type": "color", "description": "Primary button background, resting", "values": { "light": { "alias": "color/neutral/800" }, "dark": { "alias": "color/neutral/100" } } },
        "action/primary/hover": { "type": "color", "description": "Primary button background, hovered", "values": { "light": { "alias": "color/neutral/700" }, "dark": { "alias": "color/neutral/200" } } },
        "action/primary/pressed": { "type": "color", "description": "Primary button background, being pressed", "values": { "light": { "alias": "color/neutral/900" }, "dark": { "alias": "color/neutral/300" } } },
        "action/primary/disabled": { "type": "color", "description": "Primary button background, disabled", "values": { "light": { "alias": "color/neutral/200" }, "dark": { "alias": "color/neutral/700" } } },
        "action/primary/text": { "type": "color", "description": "Primary button label colour", "values": { "light": { "alias": "color/neutral/000" }, "dark": { "alias": "color/neutral/900" } } },
        "action/secondary/default": { "type": "color", "description": "Secondary (outline) button background, resting", "values": { "light": { "alias": "color/neutral/000" }, "dark": { "alias": "color/neutral/900" } } },
        "action/secondary/hover": { "type": "color", "description": "Secondary button background, hovered", "values": { "light": { "alias": "color/neutral/200" }, "dark": { "alias": "color/neutral/800" } } },
        "action/secondary/pressed": { "type": "color", "description": "Secondary button background, being pressed", "values": { "light": { "alias": "color/neutral/300" }, "dark": { "alias": "color/neutral/700" } } },
        "action/secondary/text": { "type": "color", "description": "Secondary button label colour", "values": { "light": { "alias": "color/neutral/900" }, "dark": { "alias": "color/neutral/100" } } },
        "action/secondary/border": { "type": "color", "description": "Secondary button border colour", "values": { "light": { "alias": "color/neutral/800" }, "dark": { "alias": "color/neutral/200" } } }
      }
    },

    "text primitives": {
      "$description": "Typography raw values. The font SIZES change per screen width - that is what the three modes are. Written mobile-first: the ':root' values are the small-screen ones, then media queries override them as the screen gets wider.",
      "modes": ["sm (<800)", "md (>800)", "lg (>1280)"],
      "cssStrategy": {
        "sm (<800)": ":root",
        "md (>800)": "@media (min-width: 800px)",
        "lg (>1280)": "@media (min-width: 1280px)"
      },
      "unit": "px",
      "tokens": {
        "font-family/sans": { "type": "fontFamily", "unit": "", "description": "The only typeface in the system", "values": { "sm (<800)": "Poppins", "md (>800)": "Poppins", "lg (>1280)": "Poppins" } },
        "font-size/100": { "type": "number", "description": "Body / button / navigation text - same at every width", "values": { "sm (<800)": 16, "md (>800)": 16, "lg (>1280)": 16 } },
        "font-size/200": { "type": "number", "description": "Small headline and caption", "values": { "sm (<800)": 16, "md (>800)": 24, "lg (>1280)": 24 } },
        "font-size/300": { "type": "number", "description": "Medium headline", "values": { "sm (<800)": 32, "md (>800)": 32, "lg (>1280)": 40 } },
        "font-size/400": { "type": "number", "description": "Large headline", "values": { "sm (<800)": 32, "md (>800)": 40, "lg (>1280)": 48 } },
        "font-size/500": { "type": "number", "description": "Extra large - not currently used by any text style", "values": { "sm (<800)": 40, "md (>800)": 56, "lg (>1280)": 56 } },
        "font-size/600": { "type": "number", "description": "Display size, the biggest text in the system", "values": { "sm (<800)": 48, "md (>800)": 64, "lg (>1280)": 80 } },
        "font-weight/regular": { "type": "number", "unit": "", "description": "Normal weight (400)", "values": { "sm (<800)": 400, "md (>800)": 400, "lg (>1280)": 400 } },
        "font-weight/semibold": { "type": "number", "unit": "", "description": "Semi bold weight (600)", "values": { "sm (<800)": 600, "md (>800)": 600, "lg (>1280)": 600 } },
        "font-weight/bold": { "type": "number", "unit": "", "description": "Bold weight (700)", "values": { "sm (<800)": 700, "md (>800)": 700, "lg (>1280)": 700 } }
      }
    },

    "space primitives": {
      "$description": "The spacing scale - every gap, padding and margin should come from here so the rhythm of the page stays consistent.",
      "modes": ["default"],
      "cssStrategy": { "default": ":root" },
      "unit": "px",
      "tokens": {
        "space/100": { "type": "number", "description": "4px - tight gap, icon spacing", "values": { "default": 4 } },
        "space/200": { "type": "number", "description": "8px - small gap, inline spacing", "values": { "default": 8 } },
        "space/300": { "type": "number", "description": "12px - compact spacing", "values": { "default": 12 } },
        "space/400": { "type": "number", "description": "16px - default gap, the base unit", "values": { "default": 16 } },
        "space/500": { "type": "number", "description": "24px - comfortable spacing", "values": { "default": 24 } },
        "space/600": { "type": "number", "description": "32px - section spacing", "values": { "default": 32 } },
        "space/700": { "type": "number", "description": "48px - large section gap", "values": { "default": 48 } },
        "space/800": { "type": "number", "description": "64px - major section break", "values": { "default": 64 } },
        "space/900": { "type": "number", "description": "80px - page-level spacing", "values": { "default": 80 } }
      }
    },

    "radius primitives": {
      "$description": "Corner rounding. Figma only defines one radius, so everything rounded in this system uses the same value.",
      "modes": ["default"],
      "cssStrategy": { "default": ":root" },
      "unit": "px",
      "tokens": {
        "radius/md": { "type": "number", "description": "8px - default rounding for buttons, inputs and cards", "values": { "default": 8 } }
      }
    }
  },

  "typographyStyles": {
    "$description": "Figma text STYLES. Each one bundles a font size, weight, family, line height, letter spacing and casing into a single named recipe. Crucially, their size/weight/family are BOUND to the text primitives above - so they shrink and grow with the screen automatically. The build script turns each of these into a CSS class, e.g. .font-display-md.",
    "$lineHeightNote": "Figma stores line height as a percentage. CSS prefers a plain ratio, so 120% becomes 1.2. 'auto' means Figma lets the font decide, which maps to CSS line-height: normal.",
    "$letterSpacingNote": "Figma stores letter spacing as a percentage of the font size. The CSS 'em' unit means exactly that, so -2% becomes -0.02em and it stays correct at every font size.",
    "styles": {
      "font/display/md": { "description": "The single biggest piece of text on a page - the hero headline. Note it is UPPERCASE by design.", "fontSize": "font-size/600", "fontWeight": "font-weight/bold", "fontFamily": "font-family/sans", "lineHeight": 1.2, "letterSpacing": "-0.02em", "textTransform": "uppercase" },
      "font/headline/lg": { "description": "Large section headline.", "fontSize": "font-size/400", "fontWeight": "font-weight/bold", "fontFamily": "font-family/sans", "lineHeight": 1.45, "letterSpacing": "-0.02em" },
      "font/headline/md": { "description": "Medium headline, e.g. a sub-section title.", "fontSize": "font-size/300", "fontWeight": "font-weight/bold", "fontFamily": "font-family/sans", "lineHeight": 1.25, "letterSpacing": "-0.02em" },
      "font/headline/sm": { "description": "Small headline, e.g. a card title.", "fontSize": "font-size/200", "fontWeight": "font-weight/bold", "fontFamily": "font-family/sans", "lineHeight": 1.45, "letterSpacing": "-0.005em" },
      "font/caption/md": { "description": "Large supporting text that sits under a headline.", "fontSize": "font-size/200", "fontWeight": "font-weight/regular", "fontFamily": "font-family/sans", "lineHeight": 1.45, "letterSpacing": "-0.005em" },
      "font/body/md/default": { "description": "Standard paragraph text.", "fontSize": "font-size/100", "fontWeight": "font-weight/regular", "fontFamily": "font-family/sans", "lineHeight": 1.7, "letterSpacing": "-0.005em" },
      "font/body/md/strong": { "description": "Paragraph text, emphasised.", "fontSize": "font-size/100", "fontWeight": "font-weight/bold", "fontFamily": "font-family/sans", "lineHeight": 1.7, "letterSpacing": "-0.005em" },
      "font/link/inline": { "description": "A link inside a paragraph - underlined so it is identifiable without relying on colour.", "fontSize": "font-size/100", "fontWeight": "font-weight/regular", "fontFamily": "font-family/sans", "lineHeight": 1.7, "letterSpacing": "-0.005em", "textDecoration": "underline" },
      "font/link/md": { "description": "A standalone link, e.g. in a footer.", "fontSize": "font-size/100", "fontWeight": "font-weight/bold", "fontFamily": "font-family/sans", "lineHeight": 1.7, "letterSpacing": "-0.005em" },
      "font/button/md": { "description": "Button labels.", "fontSize": "font-size/100", "fontWeight": "font-weight/semibold", "fontFamily": "font-family/sans", "lineHeight": "normal", "letterSpacing": "0em" },
      "font/navigation/md": { "description": "Navigation links.", "fontSize": "font-size/100", "fontWeight": "font-weight/semibold", "fontFamily": "font-family/sans", "lineHeight": "normal", "letterSpacing": "0em" }
    }
  }
}
